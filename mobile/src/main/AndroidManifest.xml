<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to resolve the playing app's display name (e.g. "Spotify") -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Tempo"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Tempo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gives us access to other apps' MediaSessions once the user grants notification access -->
        <service
            android:name=".MediaSyncService"
            android:exported="true"
            android:label="Tempo"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receives commands from the watch -->
        <service
            android:name=".CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/command"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
